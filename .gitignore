# Your own library data. The root pattern only: `data/` would also match
# examples/data/, which IS tracked (the bundled example library ships with the repo).
/data/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
.DS_Store

api_keys/
/tmp/
.worktrees/

# The example library's SQLite database is regenerated and published by the
# maintainer's publish pipeline; a clone does not need to track WAL sidecars.
examples/data/library.sqlite3-wal
examples/data/library.sqlite3-shm
examples/data/cache/
examples/data/logs/
examples/data/tmp/

# Local launchd job and one-off import scripts stay out of git.
# See com.mylibrary.local.plist.example and zotero_import.py for the
# generic, shareable versions.
com.mylibrary.local.plist
add_*.py
zotero_import_*.py
